<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Dev builds talk plaintext to LocalNet via the emulator host bridge. -->
    <!-- The wallet store is encrypted under a device-bound Keystore key, so a
         restored backup could never be decrypted anyway — and wallet state
         does not belong in a cloud backup to begin with. -->
    <application
        android:name=".WalletApplication"
        android:label="Canton Wallet"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Prefetch the Play services scanner module used by the Send screen. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: a canton-checkout: QR (from any camera / QR scanner)
                 opens the wallet straight into a prefilled Send for review. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="canton-checkout" />
            </intent-filter>
        </activity>
    </application>

</manifest>

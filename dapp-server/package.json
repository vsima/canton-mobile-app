{
  "name": "canton-dapp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Canton dApp server — the public backend a wallet dials out to. Sign-in-with-Canton verification and ledger watching next to LocalNet, built on the official @canton-network SDKs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "demo": "node src/demo.ts",
    "wc-signin": "node src/wc-signin.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@canton-network/wallet-sdk": "^1.4.0",
    "@walletconnect/sign-client": "^2.23.10",
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.0"
  }
}

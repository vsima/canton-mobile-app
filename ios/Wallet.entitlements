<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reown WalletKit stores its relay client key in an App Group keychain
	     (Networking.configure(groupIdentifier:)). Declaring the group here is
	     what lets that keychain access succeed. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.vsima.canton.app</string>
	</array>
</dict>
</plist>
